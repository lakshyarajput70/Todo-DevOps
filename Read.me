===========STOP==================
kubectl delete deployment todo-frontend
kubectl delete deployment todo-backend

kubectl delete svc frontend-service
kubectl delete svc backend-service

kubectl delete configmap nginx-config
kubectl delete secret mongo-secret

======Update image===========
kubectl set image deployment/todo-frontend \
frontend=lakshyakumar70/todo-frontend:v6

kubectl set image deployment/todo-backend \
backend=lakshyakumar70/todo-backend:v4


==========Restart deployment===========
kubectl rollout restart deployment todo-frontend
kubectl rollout restart deployment todo-backend

